GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Signs session cookies (see backend/auth/session_cookie.py). Must be a real
# random value, including for local dev — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

TZ=Europe/Berlin
PORT=8000
# The public URL of the backend — must match the redirect URI in Google Cloud Console
APP_URL=http://localhost:8000

# Postgres connection string. For local docker-compose dev this matches the
# `db` service defined there; for a local (non-docker) prod-like run, point
# this at your own Postgres instance (e.g. Supabase's Session Pooler URI).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/family_calendar

# Login is per-family, stored in the `families` table and authenticated via
# a signed session cookie (POST /auth/login). No env-var credentials here —
# after running `alembic upgrade head`, create a family with
# `python -m scripts.create_family` (see root CLAUDE.md).
